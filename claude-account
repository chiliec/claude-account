#!/bin/bash
# Switch between authorized Claude Code accounts.
#
# /login overwrites the single "Claude Code-credentials" keychain item plus the
# oauthAccount/userID fields in ~/.claude.json, so the previous account has to be
# re-authorized. This keeps a per-account copy of both and swaps them back in.
#
#   claude-account              pick an account interactively
#   claude-account list
#   claude-account save [name]  snapshot the account you are logged in as now
#   claude-account use <name>
#   claude-account rm <name>
#   claude-account selftest     round-trip check against throwaway state
#
# Switching affects Claude Code sessions started afterwards.
# https://github.com/chiliec/claude-account

set -euo pipefail

SERVICE="${CLAUDE_KEYCHAIN_SERVICE:-Claude Code-credentials}"
STORE="${CLAUDE_ACCOUNTS_DIR:-$HOME/.claude/accounts}"
CONFIG="${CLAUDE_CONFIG_FILE:-$HOME/.claude.json}"
ACCT="$USER"

die() { echo "claude-account: $*" >&2; exit 1; }

kc_read() { security find-generic-password -s "$1" -a "$ACCT" -w 2>/dev/null; }

kc_write() {
  local svc=$1 secret=$2
  # ponytail: token goes through argv — security's stdin prompt truncates at 128 chars
  # and the credential blob is ~1.4 KB. Exposure is to same-user `ps` only, which is
  # the same trust boundary as reading the keychain item in the first place.
  security add-generic-password -U -s "$svc" -a "$ACCT" -w "$secret" >/dev/null 2>&1
  [ "$(kc_read "$svc")" = "$secret" ] || die "keychain write to '$svc' did not round-trip"
}

cfg() { jq -r "$1 // empty" "$CONFIG" 2>/dev/null; }

slug() { printf '%s' "${1%%@*}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-*$//'; }

# name of the stored profile matching the live login, if any
current_name() {
  local email; email=$(cfg .oauthAccount.emailAddress)
  [ -n "$email" ] || return 0
  local f
  for f in "$STORE"/*.json; do
    [ -e "$f" ] || continue
    if [ "$(jq -r '.oauthAccount.emailAddress // empty' "$f")" = "$email" ]; then
      basename "$f" .json; return 0
    fi
  done
}

save() {
  local secret name
  secret=$(kc_read "$SERVICE") || true
  [ -n "$secret" ] || die "no active login found in the keychain — run: claude /login"
  name=${1:-$(slug "$(cfg .oauthAccount.emailAddress)")}
  [ -n "$name" ] || die "no account in $CONFIG — pass a name explicitly"
  mkdir -p "$STORE"; chmod 700 "$STORE"
  kc_write "$SERVICE:$name" "$secret"
  jq '{oauthAccount, userID}' "$CONFIG" > "$STORE/$name.json"
  chmod 600 "$STORE/$name.json"
  echo "saved '$name' ($(cfg .oauthAccount.emailAddress))"
}

use() {
  local name=$1 f="$STORE/$1.json" secret tmp
  [ -f "$f" ] || die "unknown account '$name' (see: claude-account list)"
  secret=$(kc_read "$SERVICE:$name") || true
  [ -n "$secret" ] || die "'$name' has no credentials in the keychain — re-run save while logged in as it"

  # re-snapshot the live account, saved or not: Claude Code rotates the refresh token on
  # every refresh, so an old snapshot holds a revoked one and comes back as "login expired"
  if [ -n "$(kc_read "$SERVICE")" ]; then
    save "$(current_name)" >/dev/null 2>&1 || true   # best effort — must not block the switch
  fi

  kc_write "$SERVICE" "$secret"
  tmp=$(mktemp "$CONFIG.XXXXXX")
  jq --slurpfile p "$f" '.oauthAccount = $p[0].oauthAccount | .userID = $p[0].userID' "$CONFIG" > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$CONFIG"
  echo "switched to '$name' ($(cfg .oauthAccount.emailAddress)) — start a new Claude Code session"
}

list() {
  local cur f name; cur=$(current_name)
  shopt -s nullglob
  local files=("$STORE"/*.json)
  [ ${#files[@]} -gt 0 ] || die "no saved accounts yet — run: claude-account save"
  for f in "${files[@]}"; do
    name=$(basename "$f" .json)
    printf '%s %-16s %s %s\n' "$([ "$name" = "$cur" ] && echo '*' || echo ' ')" "$name" \
      "$(jq -r '.oauthAccount.emailAddress // "?"' "$f")" \
      "$(jq -r '.oauthAccount.organizationName // ""' "$f")"
  done
}

pick() {
  local cur f n=0 names=() name; cur=$(current_name)
  shopt -s nullglob
  for f in "$STORE"/*.json; do
    name=$(basename "$f" .json); names+=("$name"); n=$((n + 1))
    printf '%2d) %s %-16s %s\n' "$n" "$([ "$name" = "$cur" ] && echo '*' || echo ' ')" "$name" \
      "$(jq -r '.oauthAccount.emailAddress // "?"' "$f")"
  done
  [ $n -gt 0 ] || die "no saved accounts yet — run: claude-account save"
  read -rp "account [1-$n]: " choice
  if ! [[ $choice =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$n" ]; then
    die "invalid choice"
  fi
  use "${names[$((choice - 1))]}"
}

remove() {
  local name=${1:?usage: claude-account rm <name>}
  [ -f "$STORE/$name.json" ] || die "unknown account '$name'"
  security delete-generic-password -s "$SERVICE:$name" -a "$ACCT" >/dev/null 2>&1 || true
  rm -f "$STORE/$name.json"
  echo "removed '$name'"
}

selftest() {
  tmp=$(mktemp -d)          # global: the EXIT trap below needs them after this returns
  svc="claude-account-selftest-$$"
  trap 'security delete-generic-password -s "$svc" -a "$ACCT" >/dev/null 2>&1 || true
        security delete-generic-password -s "$svc:alice" -a "$ACCT" >/dev/null 2>&1 || true
        security delete-generic-password -s "$svc:bob" -a "$ACCT" >/dev/null 2>&1 || true
        rm -rf "$tmp"' EXIT

  export CLAUDE_KEYCHAIN_SERVICE="$svc" CLAUDE_ACCOUNTS_DIR="$tmp/accounts" CLAUDE_CONFIG_FILE="$tmp/config.json"
  local self="$0"
  login() { # fake a /login: keychain token + config identity
    printf '{"oauthAccount":{"emailAddress":"%s","organizationName":"org-%s"},"userID":"%s","keep":"me"}\n' \
      "$1" "$1" "$2" > "$tmp/config.json"
    kc_write "$svc" "token-$2"
  }

  login alice@example.com uid-a && "$self" save alice >/dev/null
  login bob@example.com   uid-b && "$self" save bob   >/dev/null

  "$self" use alice >/dev/null
  [ "$(kc_read "$svc")" = token-uid-a ] || die "selftest: keychain not switched"
  [ "$(jq -r .userID "$tmp/config.json")" = uid-a ] || die "selftest: userID not switched"
  [ "$(jq -r .oauthAccount.emailAddress "$tmp/config.json")" = alice@example.com ] || die "selftest: email not switched"
  [ "$(jq -r .keep "$tmp/config.json")" = me ] || die "selftest: clobbered unrelated config keys"
  [ "$("$self" list | grep -c '^\*')" = 1 ] || die "selftest: current account not marked"

  # a saved account's rotated token must be re-snapshotted, not reverted to the stale copy
  kc_write "$svc" token-uid-a-rotated
  "$self" use bob >/dev/null
  [ "$(kc_read "$svc:alice")" = token-uid-a-rotated ] || die "selftest: rotated token of saved account lost"

  # a login that was never saved must be snapshotted before being switched away from
  login carol@example.com uid-c
  "$self" use bob >/dev/null
  [ "$(kc_read "$svc:carol")" = token-uid-c ] || die "selftest: unsaved live account was stranded"

  "$self" rm bob >/dev/null
  [ -e "$tmp/accounts/bob.json" ] && die "selftest: rm left the profile behind"
  echo "selftest ok"
}

case "${1:-pick}" in
  list) list ;;
  save) save "${2:-}" ;;
  use)  use "${2:?usage: claude-account use <name>}" ;;
  rm)   remove "${2:-}" ;;
  pick) pick ;;
  selftest) selftest ;;
  -h|--help|help) awk 'NR>1 && /^#/ { print substr($0, 3); next } NR>1 { exit }' "$0" ;;
  *) die "unknown command '$1' (try: --help)" ;;
esac
